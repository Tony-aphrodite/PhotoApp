rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Correo confirmado. La app ya retiene a las cuentas sin verificar en su
    // pantalla de verificación; esto lo hace valer también para quien use el
    // SDK directamente. Se exige en las acciones que generan actividad
    // (servicios, mensajes, cotizaciones, citas, reseñas, documentos), no en
    // el registro: el perfil se crea antes de que llegue el correo.
    // El admin se aprovisiona con emailVerified: true.
    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    // Campos de un servicio que solo escribe Cloud Functions: el dinero
    // cobrado o por cobrar, y el estado del flujo de cotización y trabajo
    // (functions/src/service-flow.ts), que decide ese dinero.
    function serverMoneyFields() {
      return ['costoFinal', 'montoPagado', 'comisionPlataforma', 'montoTecnico',
              'estadoPago', 'stripePaymentIntentId', 'paidAt',
              'cotizacionPendienteId', 'cotizacionAprobadaId', 'detencion',
              'resolucion', 'iniciadoAt', 'completadoAt',
              // Flujo de visita de diagnóstico (functions/src/visit-flow.ts):
              // el tipo de flujo y el precio de la visita salen de la
              // configuración de la categoría, no del cliente.
              'flujo', 'visita', 'autoCierre', 'revisionAt', 'revisionTarea',
              'cierre', 'montoSaldo'];
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isCliente() {
      return isAuthenticated() && getUserRole() == 'cliente';
    }

    function isTecnico() {
      return isAuthenticated() && getUserRole() == 'tecnico';
    }

    // ===== USERS COLLECTION =====
    match /users/{userId} {
      // Lectura: propio perfil, admin, o clientes pueden ver perfiles de técnicos (para modelo híbrido)
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin() ||
        // Clientes pueden leer perfiles de técnicos para selección híbrida
        (isCliente() && resource.data.rol == 'tecnico' && resource.data.activo == true)
      );

      // Listar técnicos: clientes pueden buscar técnicos disponibles
      allow list: if isAuthenticated() && (
        isAdmin() ||
        isCliente()
      );

      // Creación: cualquier usuario autenticado puede crear SU PROPIO
      // documento — pero nunca con rol 'admin'. Antes esto era
      // `if isAuthenticated()` sin más, lo cual dejaba una vía real de
      // escalación: cualquiera con el SDK de cliente (no solo desde la UI de
      // la app) podía escribir rol: 'admin' directamente al registrarse.
      //
      // Las cuentas de administrador no se crean desde la app. Se aprovisionan
      // en el despliegue por functions/scripts/seed-admin.js, que usa el Admin
      // SDK y por tanto omite estas reglas. Ver ese archivo.
      //
      // Además, el teléfono debe quedar reclamado por esta misma cuenta en
      // telefonos/{telefono} dentro del mismo batch (ver esa colección). Sin
      // esto, una cuenta podía registrarse con el número de otra.
      allow create: if isAuthenticated() &&
                      request.auth.uid == userId &&
                      request.resource.data.rol in ['cliente', 'tecnico'] &&
                      request.resource.data.telefono is string &&
                      request.resource.data.telefono.matches('^[2-9][0-9]{9}$') &&
                      getAfter(/databases/$(database)/documents/telefonos/$(request.resource.data.telefono)).data.uid == request.auth.uid;

      // Actualización: propio perfil o admin
      // Campos calculados por Cloud Functions (rating, servicios completados,
      // estado de facturación y organization de FacturAPI, graciaExpiraAt) no se
      // pueden modificar desde el cliente ni por el propio usuario.
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'rol',
            // Cambiarlo esquivaría la unicidad de telefonos/. No hay pantalla
            // para editarlo; si se necesita, debe hacerse en el servidor.
            'telefono',
            'calificacionPromedio',
            'totalResenas',
            'serviciosCompletados',
            'facturapi',
            'graciaExpiraAt',
            'stripeConnectAccountId',
            // Contadores de incidencias del técnico (no se presentó,
            // canceló, detuvo un trabajo); solo los escribe el servidor.
            'incidencias'
          ]);

      allow delete: if isAdmin();
    }

    // ===== TELEFONOS COLLECTION =====
    // Un documento por teléfono registrado; el id son los 10 dígitos
    // nacionales. Garantiza que un número pertenezca a una sola cuenta.
    //
    // Solo se permite CREAR. Si el número ya tiene dueño, la escritura cuenta
    // como actualización, se rechaza, y con ella todo el batch del registro.
    // Nadie puede leerlos desde la app, así que no sirven para averiguar si un
    // número está registrado ni de quién es.
    //
    // Los teléfonos de usuarios anteriores a esta regla se reclaman con
    // functions/scripts/backfill-phone-claims.js (paso del despliegue).
    match /telefonos/{telefono} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
                      telefono.matches('^[2-9][0-9]{9}$') &&
                      request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
                      request.resource.data.uid == request.auth.uid &&
                      getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.telefono == telefono;
      allow update, delete: if false;
    }

    // ===== SERVICIOS COLLECTION =====
    match /servicios/{servicioId} {
      // Lectura: admin, cliente dueño, técnico asignado
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isCliente() && resource.data.clienteId == request.auth.uid) ||
        (isTecnico() && resource.data.get('tecnicoId', null) == request.auth.uid)
      );

      // Creación: clientes o admin
      // Cliente puede seleccionar técnico al crear (tipoAsignacion = "cliente")
      // o dejar sin técnico para asignación automática/admin
      // Los campos de dinero los escriben el técnico (cotización), el admin o
      // Cloud Functions — nunca el cliente, que es quien paga. createPaymentIntent
      // cobra a partir de costoFinal cuando no hay cotización aprobada.
      allow create: if isAuthenticated() && isVerified() && (isCliente() || isAdmin()) &&
                      (isAdmin() || !request.resource.data.keys().hasAny(serverMoneyFields())) &&
                      request.resource.data.estado == 'pendiente' &&
                      request.resource.data.tipoAsignacion in ['cliente', 'automatica', 'admin'];

      // Actualización:
      // - Admin puede todo
      // - Cliente: edita su solicitud mientras está pendiente, la cancela antes
      //   de que empiece el trabajo, o adjunta fotos
      // - Técnico: nada directo. Cotizar, iniciar, terminar y detener pasan por
      //   Cloud Functions (service-flow.ts), porque cada paso fija el monto
      //   que se cobrará. Antes el técnico podía escribir cualquier estado,
      //   incluido 'completado' sin cotización aprobada.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isCliente() &&
         resource.data.clienteId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverMoneyFields().concat(['estimacionCosto'])) &&
         // While pendiente the cliente may edit the request, but not jump it
         // to another state.
         ((resource.data.estado == 'pendiente' &&
           request.resource.data.estado in ['pendiente', 'cancelado']) ||
          // Cancelling is allowed until work starts — standard flow only. A
          // diagnostic service may hold or have charged a visit fee, so it is
          // cancelled through visitAction, which releases or keeps the money.
          (resource.data.get('flujo', 'estandar') != 'diagnostico' &&
           resource.data.estado in ['asignado', 'cotizacion_enviada',
                                    'cotizacion_rechazada', 'cotizacion_aprobada'] &&
           request.resource.data.estado == 'cancelado' &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'updatedAt'])) ||
          // Attaching photo URLs, written moments after create — by which time
          // onServiceCreated may already have assigned the service.
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fotos', 'fotosThumbs', 'updatedAt'])))
      );

      allow delete: if isAdmin();

      // Subcollection: private
      // Sensitive contact details (client phone) live here so we can gate
      // reads on service status. UI only calls these once the técnico is
      // actually on-site or the service has been paid.
      match /private/{doc} {
        allow read: if isAuthenticated() && (
          isAdmin() ||
          // Cliente owner can always read their own contact info
          get(/databases/$(database)/documents/servicios/$(servicioId)).data.clienteId == request.auth.uid ||
          // Técnico assigned to the service can read once we're past the quotation phase
          (isTecnico() &&
           get(/databases/$(database)/documents/servicios/$(servicioId)).data.get('tecnicoId', null) == request.auth.uid &&
           get(/databases/$(database)/documents/servicios/$(servicioId)).data.estado in
             ['en_progreso', 'revision_enviada', 'revision_rechazada', 'detenido',
              'en_disputa', 'completado', 'pago_pendiente', 'pagado',
              // Visita de diagnóstico: el técnico ya va en camino o está ahí.
              'en_camino', 'diagnostico_realizado', 'reporte_no_llego'])
        );

        // Only the cliente owner (or admin) can create/update the private
        // contact subdoc — same policy as writing to the parent service.
        allow create: if isAuthenticated() && (
          isAdmin() ||
          get(/databases/$(database)/documents/servicios/$(servicioId)).data.clienteId == request.auth.uid
        );
        allow update: if isAuthenticated() && (
          isAdmin() ||
          get(/databases/$(database)/documents/servicios/$(servicioId)).data.clienteId == request.auth.uid
        );
        allow delete: if isAdmin();
      }

      // Subcollection: fotos
      // Photos of the reported problem, written by the cliente right after
      // creating the service. Stored as base64 data URLs (the app does not use
      // Cloud Storage). Same audience as the parent service.
      match /fotos/{fotoId} {
        allow read: if isAuthenticated() && (
          isAdmin() ||
          get(/databases/$(database)/documents/servicios/$(servicioId)).data.clienteId == request.auth.uid ||
          get(/databases/$(database)/documents/servicios/$(servicioId)).data.get('tecnicoId', null) == request.auth.uid
        );

        allow create: if isAuthenticated() && (
          isAdmin() ||
          get(/databases/$(database)/documents/servicios/$(servicioId)).data.clienteId == request.auth.uid
        );

        allow update, delete: if isAdmin();
      }

      // Subcollection: mensajes
      match /mensajes/{mensajeId} {
        allow read: if isAuthenticated() && (
          isAdmin() ||
          get(/databases/$(database)/documents/servicios/$(servicioId)).data.clienteId == request.auth.uid ||
          get(/databases/$(database)/documents/servicios/$(servicioId)).data.get('tecnicoId', null) == request.auth.uid
        );

        allow create: if isAuthenticated() && isVerified() && (
          isAdmin() ||
          get(/databases/$(database)/documents/servicios/$(servicioId)).data.clienteId == request.auth.uid ||
          get(/databases/$(database)/documents/servicios/$(servicioId)).data.get('tecnicoId', null) == request.auth.uid
        ) && (
          request.resource.data.userId == request.auth.uid ||
          // System narration ("Técnico asignado: X", "Cotización enviada…")
          // is written by the participant whose action triggered it, but is
          // authored as 'system' so the UI renders it as a grey pill rather
          // than that person's message. Without this the write is denied and
          // every lifecycle event fails — including the push notifications,
          // which ride on these messages.
          (request.resource.data.userId == 'system' &&
           request.resource.data.tipo == 'sistema')
        );

        allow update: if isAuthenticated() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido']);
      }
    }

    // ===== RESENAS COLLECTION (NEW - Hybrid Model) =====
    match /resenas/{resenaId} {
      // Lectura: cualquier usuario autenticado puede ver reseñas (para elegir técnico)
      allow read: if isAuthenticated();

      // Creación: solo el cliente del servicio completado
      allow create: if isAuthenticated() && isVerified() &&
                      isCliente() &&
                      request.resource.data.clienteId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['servicioId', 'clienteId', 'tecnicoId', 'calificacion']) &&
                      request.resource.data.calificacion >= 1 &&
                      request.resource.data.calificacion <= 5;

      // Actualización: solo el cliente que la creó (para editar comentario)
      allow update: if isAuthenticated() &&
                      resource.data.clienteId == request.auth.uid &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['servicioId', 'clienteId', 'tecnicoId']);

      // Eliminación: solo admin
      allow delete: if isAdmin();
    }

    // ===== CONFIGURACION COLLECTION =====
    match /configuracion/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===== TRANSACCIONES COLLECTION =====
    match /transacciones/{transaccionId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clienteId == request.auth.uid ||
        resource.data.tecnicoId == request.auth.uid
      );
      allow create: if false; // Only via Cloud Functions
      allow update: if false; // Only via Cloud Functions
      allow delete: if isAdmin();
    }

    // ===== COTIZACIONES COLLECTION (Diagnostic Quotations) =====
    match /cotizaciones/{cotizacionId} {
      // Lectura: admin, cliente del servicio, técnico que creó la cotización
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clienteId == request.auth.uid ||
        resource.data.tecnicoId == request.auth.uid
      );

      // Escritura: solo Cloud Functions (submitQuotation / respondQuotation).
      // El servidor calcula los totales a partir de los conceptos y copia el
      // total aprobado al servicio. Antes el técnico podía editar una
      // cotización pendiente — incluido el total — mientras el cliente la
      // revisaba, y el cliente aprobaba escribiendo el estado él mismo.
      allow create, update: if false;

      allow delete: if isAdmin();
    }

    // ===== CITAS COLLECTION (Appointments) =====
    match /citas/{citaId} {
      // Lectura: admin, cliente de la cita, técnico de la cita
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clienteId == request.auth.uid ||
        resource.data.tecnicoId == request.auth.uid
      );

      // Creación: clientes autenticados
      allow create: if isAuthenticated() && isVerified() &&
                      (isCliente() || isAdmin()) &&
                      request.resource.data.estado == 'programada';

      // Actualización:
      // - Admin: puede todo
      // - Técnico: puede confirmar, completar, marcar no_asistio
      // - Cliente: puede cancelar
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isTecnico() &&
         resource.data.tecnicoId == request.auth.uid &&
         request.resource.data.estado in ['confirmada', 'completada', 'no_asistio']) ||
        (isCliente() &&
         resource.data.clienteId == request.auth.uid &&
         request.resource.data.estado == 'cancelada' &&
         resource.data.estado in ['programada', 'confirmada'])
      );

      allow delete: if isAdmin();
    }

    // ===== TARIFAS COLLECTION =====
    // Admin-managed pricing table read by all authenticated users so the app
    // can show baseline rates. Writes are locked to admin.
    match /tarifas/{tarifaId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ===== FACTURAS COLLECTION (CFDI records) =====
    // Row per stamped CFDI. Created/updated ONLY by Cloud Functions
    // (invoice stamping + monthly commission cron). Client apps only read.
    match /facturas/{facturaId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.tecnicoUid == request.auth.uid ||
        resource.data.get('clienteUid', null) == request.auth.uid
      );
      // Enforce that CFDI records are only ever written from the admin SDK
      // (Cloud Functions). Direct client writes would be a compliance risk.
      allow create, update, delete: if false;
    }

    // ===== ADMIN_FLAGS (Moderation queue) =====
    // Populated by Cloud Functions (contact-info filter, deferred CFDI,
    // dispute triggers, etc.). Only admins read; only Cloud Functions write.
    match /admin_flags/{flagId} {
      allow read: if isAdmin();

      // Creation stays server-side only: a flag is evidence, and a client that
      // could write one could also fabricate one.
      allow create, delete: if false;

      // An admin may only move the review state — mark an alert as reviewed,
      // reopen it, or leave a note. Everything the Cloud Function recorded
      // (who, when, the original text) is immutable, so the audit trail cannot
      // be edited after the fact.
      allow update: if isAdmin() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['estado', 'revisadoPor', 'revisadoAt', 'notaAdmin']) &&
                      request.resource.data.estado in ['pendiente', 'revisada'];
    }

    // ===== NOTIFICACIONES_ADMIN (broadcast history) =====
    // One row per push an admin sent, written by the sendAdminBroadcast
    // callable after fan-out. Admins read the history; nobody writes from a
    // client, so the log cannot be padded or edited.
    match /notificaciones_admin/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ===== CATEGORIAS (in configuracion/categorias, admin-editable) =====
    // Covered by the /configuracion rule above: everyone signed in reads,
    // only admins write.

    // ===== VALIDACION_DOCUMENTOS (Technician Document Validation) =====
    match /validacion_documentos/{userId} {
      // Lectura: admin o el propio técnico
      allow read: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == userId
      );

      // Creación/Actualización: técnico sube sus documentos, admin aprueba/rechaza
      allow create: if isAuthenticated() && isVerified() && request.auth.uid == userId;

      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && isVerified()) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }
  }
}
