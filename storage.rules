rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 8 MiB ceiling: the app uploads JPEGs resized to a 1600 px long edge,
    // which land around 250-400 KB. The margin absorbs an unusually large
    // photo; anything above it is not a phone camera image.
    // Uploads cost storage and bandwidth, so an account must have confirmed
    // its email first — the same gate firestore.rules put on every activity
    // write. Reads and deletes of one's own files stay open.
    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isImageUpload() {
      return request.resource.contentType.matches('image/.*')
             && request.resource.size < 8 * 1024 * 1024;
    }

    // ---------------------------------------------------------------------
    // How access actually works here
    //
    // Writes are authorised by path: every upload folder ends in the
    // uploader's uid, so a user can only ever write under their own prefix.
    //
    // Reads by path are owner-only. The other participants of a service reach
    // an image through the download URL stored on the Firestore document
    // (servicios/{id}.fotos, the message, the user profile) — and those
    // documents are themselves restricted by firestore.rules to the cliente,
    // the assigned técnico, and admins. So the access boundary is enforced,
    // just on the document rather than on the object.
    //
    // This is the same model Firebase's own getDownloadURL() produces: it
    // checks rules to *hand out* a tokenised URL, and that URL then works on
    // its own. Gating the object read on service membership instead would need
    // a cross-service firestore.get(), which cannot be published until a
    // project Owner grants the Storage service agent a Firestore read role.
    // Worth doing later; not required for the boundary to hold.
    // ---------------------------------------------------------------------

    // Photos attached to a service request.
    // Path: servicios/{servicioId}/{uid}/{uuid}.jpg  (+ _thumb.jpg)
    match /servicios/{servicioId}/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isVerified() && isImageUpload();
      allow delete: if isOwner(uid);
    }

    // Images sent inside a service chat.
    match /chat/{servicioId}/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isVerified() && isImageUpload();
      allow delete: if isOwner(uid);
    }

    // Profile photos.
    match /usuarios/{uid}/perfil/{fileName} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isVerified() && isImageUpload();
      allow delete: if isOwner(uid);
    }

    // Técnico identity and certification documents (INE, CURP, comprobantes).
    // The most sensitive bucket content — personal identity documents. Only
    // the owner may touch them by path; an admin validates through the URL on
    // the user document, which firestore.rules already restricts to admins and
    // the técnico themselves.
    match /usuarios/{uid}/documentos/{documentKey}/{fileName} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isVerified() && isImageUpload();
      allow delete: if isOwner(uid);
    }

    // CFDI artifacts (XML + branded PDF) written by Cloud Functions with the
    // Admin SDK, which bypasses these rules entirely. No client ever reads or
    // writes them by path — the app opens the download URL held on the
    // rules-protected `facturas` document.
    match /facturas/{facturaFile} {
      allow read, write: if false;
    }

    // Public APK downloads for user testing, linked from the website. Anyone
    // may read — that is the point of a download link — and nobody may write
    // from a client: the file is replaced by hand in the Firebase console, so
    // the fixed URL keeps working across versions.
    match /descargas/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Anything not matched above is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
