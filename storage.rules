rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Nothing in this bucket is reached by a client through these rules.
    //
    // CFDI artifacts live at facturas/{facturaId}.{xml,pdf}. Cloud Functions
    // write them with the Admin SDK, which bypasses rules entirely, and the app
    // opens them through the download-token URL saved on the Firestore
    // `facturas` document. That document is already restricted to the emisor
    // técnico, the receptor cliente, and admins — so the access boundary is
    // enforced there, and anyone able to read the URL could read the invoice
    // anyway.
    //
    // An earlier version gated reads here with firestore.get() against the
    // `facturas` document. That is stricter in principle, but cross-service
    // rules cannot even be *published* until a project Owner grants the Storage
    // service agent a Firestore read role — the Console rejects them outright.
    // Restore that version if the app ever switches to
    // FirebaseStorage.ref(path).getDownloadURL(), which does go through rules.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
