{
  "name": "servitec-functions",
  "description": "Cloud Functions for ServiTec — Stripe Connect + FacturAPI CFDI issuance",
  "scripts": {
    "lint": "eslint --ext .ts src",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "facturapi": "^4.18.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.4",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3"
  },
  "private": true
}
