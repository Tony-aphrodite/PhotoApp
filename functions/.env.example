# Copy to .env and fill in real values before deploy.
# NEVER commit .env — it's in .gitignore.

# ---- Stripe ----
# Secret key (sk_test_... or sk_live_...) — used by the Cloud Function to
# create PaymentIntents and manage Connect accounts.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...) — used to verify Stripe webhook signatures.
STRIPE_WEBHOOK_SECRET=

# Platform account ID (acct_...) — for informational logging.
STRIPE_PLATFORM_ACCOUNT_ID=

# ---- FacturAPI ----
# Live secret key (sk_live_...) or sandbox key (sk_test_...).
FACTURAPI_API_KEY=

# Parent organization id for ServiTec — used when issuing the monthly commission
# CFDI (ServiTec → técnico).
FACTURAPI_SERVITEC_ORG_ID=

# ---- Platform ----
# Platform commission percentage (0-100).
PLATFORM_COMMISSION_PCT=12

# Setup code that turns a signed-in user's own account into an admin (see
# functions/src/admin-bootstrap.ts). Pick a long random string — anyone who
# has it can make themselves an admin. Share it only with whoever should have
# admin access; it is reusable, not a one-time code.
ADMIN_BOOTSTRAP_CODE=
